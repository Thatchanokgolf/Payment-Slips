# EasySlip API token — primary slip extraction. Reads the slip's QR and returns
# the bank-verified transaction. Get one at https://easyslip.com/
EASYSLIP_API_KEY=your-easyslip-api-key

# Anthropic API key — BACKUP slip extraction (Claude vision), used only when
# EasySlip can't verify a slip (no/unreadable QR, quota, service down, or the
# token above is unset). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Neon Postgres connection string.
# Create a database at https://neon.tech and copy its pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Optional — port the server listens on (defaults to 3000).
# PORT=3000

# PIN required to edit or delete a payment from the dashboard (defaults to 0112).
# EDIT_PIN=0112

# --- Google Sheets sync (optional) -----------------------------------------
# Leave these unset to disable the sync; the app then works exactly as before.
# The target Sheet ('ฟอร์มจ่ายเงินใหม่' tab) is already configured in
# lib/sheets.js, so you only need the two credentials below. Slip images are
# stored in the database and served from /api/image/:id — the sheet's =IMAGE()
# cells point there — so no Google Drive folder or Drive API is needed.
# Create a Google Cloud service account, enable the Sheets API, then share the
# Sheet (Editor) with this email:
GOOGLE_SERVICE_ACCOUNT_EMAIL=payment-slips@your-project.iam.gserviceaccount.com
# Paste the whole private key on ONE line, in double quotes, with \n for newlines:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n...\n-----END PRIVATE KEY-----\n"

# Optional overrides (defaults live in lib/sheets.js):
# GOOGLE_SHEET_ID=...
# GOOGLE_SHEET_TAB=ฟอร์มจ่ายเงินใหม่
